{
  "name": "light-vuerd",
  "displayName": "Light Vuerd",
  "description": "A lightweight ERD viewer for Vuerd JSON files in VS Code.",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "icon": "media/logo.png",
  "publisher": "ngounhengkimlaydev",
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "vuerd",
    "erd",
    "database",
    "diagram",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ngounhengkimlaydev/Light-Vuerd"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:lightVuerd.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lightVuerd.open",
        "title": "Light Vuerd: Open ERD"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "lightVuerd.open",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  }
}
